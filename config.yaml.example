server:
  port: ":8080"
  mode: "debug" # debug, release

database:
  driver: "sqlite" # sqlite, mysql
  dsn: "smsie.db"

serial:
  scan_interval: 5s
  exclude_ports:
    # - "COM1"
  init_at_commands:
    - "ATE0"
    - "AT+COPS=3,2"
    - "AT+CMGF=0" # PDU mode

calling:
  stun_servers:
    - "stun:stun.l.google.com:19302"
  udp_port_min: 40000
  udp_port_max: 40100
  sip:
    register_expires: 300
    local_host: "" # optional, auto-detect if empty
    local_port: 5060 # base listener port, auto-assigns upward when a modem has no fixed port yet
    rtp_bind_ip: "0.0.0.0"
    rtp_port_min: 30000
    rtp_port_max: 30010
    invite_timeout_sec: 30
    dtmf_method: "info"
    dtmf_duration_ms: 160
  audio:
    device_keyword: "AC Interface"
    output_device_name: ""
    sample_rate: 8000
    channels: 1
    bits_per_sample: 16
    capture_chunk_ms: 40
    playback_chunk_ms: 100

log:
  level: "info" # debug, info, warn, error

balance:
  enabled: true            # đọc *101# tự động mỗi ngày
  check_hour: 6            # giờ địa phương đọc số dư
  low_threshold_vnd: 20000 # ngưỡng cảnh báo mặc định (per-SIM: low_balance_vnd)
  forecast_days: 7         # cảnh báo khi dự kiến hết tiền trong N ngày
  ussd_code: "*101#"

sim_health:
  enabled: true            # cảnh báo SIM "chết" (cùng chu kỳ với balance)
  no_sms_days: 30          # không nhận SMS nào N ngày → có thể bị thu hồi
  unregistered_hours: 24   # modem online nhưng không đăng ký mạng N giờ
  absent_days: 7           # rút khỏi khay N ngày chưa cắm lại
  remind_days: 7           # nhắc lại mỗi N ngày

keepalive:
  enabled: false           # nuôi SIM — TỐN TIỀN (gửi SMS nội mạng), phải bật tường minh
  interval_days: 25        # gửi khi không có SMS đi/đến trong N ngày (per-SIM: keepalive_interval)
  max_per_month: 3         # trần số lần gửi mỗi SIM mỗi tháng dương lịch
  message: "keepalive {{.Date}}"   # nội dung; {{.Date}} = yyyy-mm-dd
  run_hour: 7              # giờ chạy hằng ngày (sau giờ đọc số dư)

phone_lookup:
  enabled: true            # tự tra số thuê bao qua USSD khi SIM chưa có số (sau probe / đảo SIM)
  codes:                   # theo tên nhà mạng worker đọc được (+COPS / mccmnc.json), so khớp không phân biệt hoa thường
    Viettel: "*098#"
    Vinaphone: "*110#"
    Mobifone: "*0#"
    Vietnamobile: "*102#"
